# Real labeled benchmark raw data (fetched from official sources, see each
# evaluation/<name>/README.md for the exact download commands) — not
# committed, same size-based reasoning as testing/.
evaluation/rsvqa_lr/raw/
evaluation/levir_cd/raw/
evaluation/cdvqa/raw/
evaluation/second_dataset/raw/
evaluation/vrsbench/raw/

