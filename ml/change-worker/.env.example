# Change detection worker environment (non-secret). Copy to .env or set in your shell.
# The backend reads CHANGE_WORKER_URL from backend/.env.

# Listen port for the worker HTTP service
CHANGE_WORKER_PORT=8002

# Path to the trained model checkpoint (relative to this directory)
# MODEL_PATH=../change_model/trained/best_change_model.pt

# Optional: absolute path to a python.exe that already has the worker
# requirements installed. When empty, run_worker.ps1 looks for ml/change-worker/venv.
CHANGE_WORKER_PYTHON=
