# VQA worker environment (non-secret). Copy to .env or set in your shell.
# The backend reads VQA_WORKER_URL from backend/.env.

# Listen port for the worker HTTP service
VQA_WORKER_PORT=8001

# Base model: HF repo id, or a local snapshot dir to avoid downloading.
MODEL_DIR=HuggingFaceTB/SmolVLM-256M-Instruct
# Tested local snapshot (no download, exact Phase 7C weights):
# MODEL_DIR=C:\Users\ihars\.cache\huggingface\hub\models--HuggingFaceTB--SmolVLM-256M-Instruct\snapshots\7e3e67edbbed1bf9888184d9df282b700a323964

# Experimental Stage 3 BigEarthNet LoRA adapter (durable copy)
ADAPTER_DIR=../smolvlm/lora_stage3

# Optional: absolute path to a python.exe that already has the worker
# requirements installed (e.g. the tested Phase 7C env). When empty,
# run_worker.ps1 looks for ml/vqa-worker/venv.
VQA_WORKER_PYTHON=